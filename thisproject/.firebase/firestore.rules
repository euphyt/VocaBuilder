// Firestore security rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /history/{hid} {
        allow read, list: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['text','createdAt','isFavorite','source'])
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.isFavorite is bool;
        allow update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isFavorite']);
        allow delete: if false;
      }

      match /stats/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
